# Keeps host build outputs and local state out of the Docker build context, because the Dockerfile builds web/dist and the binary itself.
target/
target-*/
**/node_modules/
web/dist/
site/dist/
site/public/console/
.git/
.ostra/
.design-import/
.claude/
.design-sync/
**/.vitest/
web/.shots/
*.log
**/*.log
